<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="empA" class="cg.demo.spring.beans3.Employee">
    	<property name="employeeId" value="12345"></property>
    	<property name="employeeName" value="Harriet"></property>
    	<property name="salary" value="40000.0"></property>
    </bean>
    
    <bean id="empB" class="cg.demo.spring.beans3.Employee">
    	<property name="employeeId" value="12346"></property>
    	<property name="employeeName" value="Riddhi"></property>
    	<property name="salary" value="40000.0"></property>
    </bean>
    
    <bean id="sbu2" class="cg.demo.spring.beans3.SBU">
    	<constructor-arg value="BU-PES"></constructor-arg>
    	<constructor-arg value="Product Engineering Services"></constructor-arg>
    	<constructor-arg value="Kiran Rao"></constructor-arg>
    	<constructor-arg>
    		<list>
    			<ref bean="empA"></ref>
    			<ref bean="empB"></ref>
    		</list>
    	</constructor-arg>
    </bean>

</beans>